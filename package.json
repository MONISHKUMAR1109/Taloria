{
  "name": "taloria",
  "version": "0.1.0",
  "description": "TALORIA - Where Talent Finds Its Stage. Monorepo root (backend API + frontend SPA).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup",
    "test": "npm --prefix backend test",
    "test:int": "npm --prefix backend run test:int"
  }
}