# TALORIA backend environment
# Copy to .env (never commit .env)

NODE_ENV=development
PORT=4000

# After: docker compose up -d  (or your local PostgreSQL 15 instance)
DATABASE_URL=postgres://taloria:taloria@localhost:5432/taloria

# Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email delivery is stubbed in dev (links are logged to the server console).
FRONTEND_BASE_URL=http://localhost:5173

# Object storage (local driver is the v1 default; keys only in the database)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=taloria
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true